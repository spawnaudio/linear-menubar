{
  "name": "linear-menubar",
  "version": "0.1.0",
  "private": true,
  "description": "A small menubar utility to run a focus timer linked to a Linear issue, built for ADHD task management.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.electron.json && node scripts/copy-assets.mjs",
    "build": "npm run build:renderer && npm run build:main",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "lint": "eslint .",
    "electron:dev": "npm run build:main && cross-env NODE_ENV=development electron .",
    "start": "npm run build && cross-env NODE_ENV=production electron .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@linear/sdk": "^37.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@vitejs/plugin-react": "^4.3.2",
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "menubar": "^9.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.8"
  }
}
